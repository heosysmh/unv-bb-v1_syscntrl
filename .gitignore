# Working folder (traversable for Efinity project files)
work/*
!work/efinity/
work/efinity/*
!work/efinity/*.xml
!work/efinity/*.isf
!work/efinity/*.json

# Efinity Backup- und Log-files
*.bak
*.log
*.rpt

# GHDL / Simulationsdateien
*.cf
*.vcd
*.ghw

# VS Code & Firmware build artefacts
sw/app/build/*
*.o
*.d
*.elf
*.bin
*.hex

# Unused bsp content (generated automatically by efinity, can be copied 1:1)
**/EfxSapphireSoc/app
**/EfxSapphireSoc/openocd
**/EfxSapphireSoc/lauterbach_trace32

**/freeRTOS/

**/standalone/*
!**/standalone/bootloader
**/standalone/bootloader/build
!**/standalone/common
!**/standalone/driver


# TerosHDL local state
.teroshdl*

# ZooCode plans and temporary data
**/plans
**/zooCode

# Doc generation & Python
.venv/
__pycache__/
*.pyc
build-docs/
site/
docs/api/*
!docs/api/vhdl/

# Binaries for flashing explicitly tracked
!binaries/*.bin
!binaries/*.hex
